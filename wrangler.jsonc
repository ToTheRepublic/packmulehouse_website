{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "packmulehouse-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-10",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Run Worker first so we can set no-cache on HTML/JS while iterating
    "run_worker_first": true
  },
  // Public Square config (safe in frontend / wrangler vars)
  "vars": {
    "SQUARE_APPLICATION_ID": "sandbox-sq0idb-dvcNz5fkPbzX4fuFaxg57Q",
    "SQUARE_LOCATION_ID": "LKJ4C91RD6JQH",
    "SQUARE_ENVIRONMENT": "sandbox",
    "SHIPPING_CENTS": "1000",
    "MERCHANT_NOTIFY_EMAIL": "packmulehouse@gmail.com"
  },
  // Secrets: SQUARE_ACCESS_TOKEN (required), RESEND_API_KEY (optional, better email)
  // Local: .dev.vars (gitignored)
  "observability": {
    "enabled": true
  }
}
