{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "packmulehouse-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-10",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    // Disable clean-URL rewrites that redirect *.html → extensionless paths
    "html_handling": "none"
  },
  "kv_namespaces": [
    {
      "binding": "MTO_STATE",
      "id": "364c9dbc453441958387a99da3afb5bd"
    }
  ],
  "vars": {
    "SQUARE_APPLICATION_ID": "sandbox-sq0idb-dvcNz5fkPbzX4fuFaxg57Q",
    "SQUARE_LOCATION_ID": "LKJ4C91RD6JQH",
    "SQUARE_ENVIRONMENT": "sandbox",
    "SHIPPING_CENTS": "1000",
    // Sales tax (on top of prices). Origin-style flat rate for your location — change if your accountant says otherwise.
    "TAX_PERCENT": "6",
    "TAX_NAME": "Sales Tax",
    // Tax shipping as well as merchandise (common; set "false" to tax products only)
    "TAX_APPLIES_TO_SHIPPING": "true",
    // Volume discount tiers: "minItems:percentOff,..." (highest matching tier wins)
    // Example: 3+ items 5% off, 5+ 10% off, 10+ 15% off
    "VOLUME_DISCOUNT_TIERS": "3:5,5:10,10:15",
    "MERCHANT_NOTIFY_EMAIL": "packmulehouse@gmail.com",
    "NTFY_TOPIC": "packmulehouse-orders-pmh7k2x9",
    "NTFY_SERVER": "https://ntfy.sh",
    // FOMO: only show stock when below this
    "LOW_STOCK_THRESHOLD": "10",
    // Made-to-order capacity (you re-enable via admin when drained)
    "MTO_MAX": "50",
    "MTO_PROMISE": "Ships within 1 week (all items together)"
  },
  // Secrets: SQUARE_ACCESS_TOKEN, ADMIN_PASSWORD
  // Optional: DISCORD_WEBHOOK_URL, RESEND_API_KEY, TELEGRAM_*, NTFY_TOKEN
  "observability": {
    "enabled": true
  }
}
